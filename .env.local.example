# ============================================================
#  TNF Global Summit 2026 — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to Git.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key (safe to expose in browser — RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose publicly, server-side only
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────
# Public site URL (used for iVeri return URLs, metadata). No trailing slash.
# Production cPanel: https://summit.tnfzim.com
# Vercel preview:     https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://summit.tnfzim.com

# ── Auto-reply email (Gmail SMTP) ─────────────────────────────
# Used to email confirmations to people who register, donate, submit
# abstracts, or subscribe to the newsletter. Sends from the configured
# Gmail address via nodemailer.
#
# Setup steps (do this once on the Gmail account you want to send from):
#   1. Turn on 2-Step Verification:
#        https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password (type: "Mail", device: "Other"):
#        https://myaccount.google.com/apppasswords
#   3. Paste the 16-character App Password into GMAIL_APP_PASSWORD below
#      (spaces will be stripped automatically).
#
# Gmail personal accounts allow ~500 outbound emails per day.
GMAIL_USER=mazhawidzaet@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Zimbabwe TNF Global Summit
# Optional: where replies should land (defaults to GMAIL_USER if blank)
GMAIL_REPLY_TO=info@tnfzim.com

# Optional fallback if Gmail SMTP is unavailable; the app prefers Gmail
# but will fall back to Resend when this is set.
# RESEND_API_KEY=
# RESEND_FROM=TNF Summit <updates@resend.dev>

# ── iVeri Lite (card payments) ────────────────────────────────
# Application ID + shared secret from iVeri Back Office.
# Merchant City / Address / Country / Trading Name / Technical Email must also be
# completed on the *Application* in iVeri (not only in this repo). Keep them aligned
# with src/lib/data.ts `summitInfo` merchant fields, e.g.:
#   Merchant City:    HARARE
#   Merchant Address: East Wing Block 3 Celestial Park, Borrowdale, Harare, Zimbabwe
#   Country:          Zimbabwe
#   Trading Name:     TNF Zimbabwe
#   Contact Email:    waltergkaturuza@gmail.com
# IVERI_APPLICATION_ID=
# IVERI_SHARED_SECRET=
# IVERI_GATEWAY_URL=   (optional; default host.iveri.com Authorise)
